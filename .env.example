# Copy to `.env` (which is git-ignored) and fill in your own values.
# The .env file is read once at ExecutionEngine import via python-dotenv.

# ---------- Hyperliquid ----------
# Address: required for read-only data (balances / positions).
HL_ADDRESS=0xYourEvmAddress

# Private key: required ONLY when actually placing orders (dry_run=False).
# Never commit a real key. Prefer an HL "agent" key with limited
# permissions over your master key for production.
HL_PRIVATE_KEY=0xYourPrivateKey

# ---------- Lighter (execution not wired up yet) ----------
LIGHTER_PRIVATE_KEY=0x...

# ---------- AsterDex (execution not wired up yet) ----------
ASTER_API_KEY=
ASTER_API_SECRET=
